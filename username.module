<?php

/**
 * @file
 * Automatically generate usernames based on a token string.
 */

/**
 * Implements hook_config_info().
 */
function username_config_info() {
  return array(
    'username.settings' => array(
      'label' => t('Username settings'),
      'group' => t('Configuration'),
    ),
  );
}

/**
 * Implements hook_form_FORM_ID_alter() for user_admin_settings().
 */
function username_form_user_admin_settings_alter(&$form, &$form_state, $form_id) {
  $config = config('username.settings');

  $form['username'] = array(
    '#type' => 'details',
    '#summary' => t('Username'),
    '#open' => TRUE,
    '#weight' => 5,
    '#config' => 'username.settings',
  );
  $form['username']['automatic'] = array(
    '#type' => 'checkbox',
    '#title' => t('Automatically generate usernames'),
    '#default_value' => $config->get('automatic'),
  );
  $form['username']['pattern'] = array(
    '#type' => 'textfield',
    '#title' => t('Pattern'),
    '#description' => t('The token string used to generate usernames. !token_link', array(
      '!token_link' => theme('token_tree_link', array('token_types' => array('user'))),
    )),
    '#default_value' => $config->get('pattern'),
    '#element_validate' => array('token_element_validate'),
    '#token_types' => array('user'),
    '#states' => array(
      'visible' => array(
        ':input[name=automatic]' => array('checked' => TRUE),
      ),
      'required' => array(
        ':input[name=automatic]' => array('checked' => TRUE),
      ),
    ),
  );
  $form['username']['lower_case'] = array(
    '#type' => 'checkbox',
    '#title' => t('Convert to lower case'),
    '#description' => t('If enabled, this setting will convert the output of the pattern to lowercase.'),
    '#default_value' => $config->get('lower_case'),
    '#states' => array(
      'visible' => array(
        ':input[name=automatic]' => array('checked' => TRUE),
      ),
    ),
  );
  $form['username']['page_title_automatic'] = array(
    '#type' => 'checkbox',
    '#title' => t('Automatically generate profile titles for user profiles'),
    '#default_value' => $config->get('page_title_automatic'),
  );
  $form['username']['page_title_pattern'] = array(
    '#type' => 'textfield',
    '#title' => t('Profile title pattern'),
    '#description' => t('The token string used to generate profile titles for user profiles. !token_link', array(
      '!token_link' => theme('token_tree_link', array('token_types' => array('user'))),
    )),
    '#default_value' => $config->get('page_title_pattern'),
    '#element_validate' => array('token_element_validate'),
    '#token_types' => array('user'),
    '#states' => array(
      'visible' => array(
        ':input[name=page_title_automatic]' => array('checked' => TRUE),
      ),
      'required' => array(
        ':input[name=page_title_automatic]' => array('checked' => TRUE),
      ),
    ),
  );
  $form['username']['page_title_lower_case'] = array(
    '#type' => 'checkbox',
    '#title' => t('Convert profile title to lower case'),
    '#description' => t('If enabled, this setting will convert the output of the profile title pattern to lowercase.'),
    '#default_value' => $config->get('page_title_lower_case'),
    '#states' => array(
      'visible' => array(
        ':input[name=page_title_automatic]' => array('checked' => TRUE),
      ),
    ),
  );
}

/**
 * Form validation handler for username_form_user_admin_settings_alter().
 *
 * @see user_validate_name()
 */
function username_user_admin_settings_validate($form, &$form_state) {
  $values = $form_state['values'];

  if ($values['automatic']) {
    // Pattern is required.
    if (empty($values['pattern'])) {
      form_set_error('pattern', t('The <em>Pattern</em> field is required.'));
    }

    // Pattern cannot start or end with a space.
    if (trim($values['pattern']) !== $values['pattern']) {
      form_set_error('pattern', t('The <em>Pattern</em> field cannot start or end with a space.'));
    }

    // Pattern can only contain certain characters.
    if (preg_match("/[^ a-z0-9@+_.'-\[\]:]/i", $values['pattern'])) {
      form_set_error('pattern', t('The <em>Pattern</em> field contains an illegal character.'));
    }
  }

  if ($values['page_title_automatic']) {
    // Page title pattern is required.
    if (empty($values['page_title_pattern'])) {
      form_set_error('page_title_pattern', t('The <em>Profile title pattern</em> field is required.'));
    }

    // Page title pattern cannot start or end with a space.
    if (trim($values['page_title_pattern']) !== $values['page_title_pattern']) {
      form_set_error('page_title_pattern', t('The <em>Profile title pattern</em> field cannot start or end with a space.'));
    }

    // Page title pattern can only contain certain characters.
    if (preg_match("/[^ a-z0-9@+_.'-\[\]:]/i", $values['page_title_pattern'])) {
      form_set_error('page_title_pattern', t('The <em>Profile title pattern</em> field contains an illegal character.'));
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for user_register_form().
 */
function username_form_user_register_form_alter(&$form, &$form_state, $form_id) {
  if (config_get('username.settings', 'automatic')) {
    // Hide the username field.
    $form['account']['name']['#type'] = 'hidden';

    // Set a temporary random string so it passes validation.
    $form['account']['name']['#value'] = user_password();
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for user_profile_form().
 */
function username_form_user_profile_form_alter(&$form, &$form_state, $form_id) {
  $config = config('username.settings');

  if ($config->get('automatic')) {
    // Disable the username field.
    $form['account']['name']['#disabled'] = TRUE;

    // Set a description explaining why it's disabled.
    $form['account']['name']['#description'] = t('This value is being automatically generated.');
    if (user_access('administer account settings')) {
      $form['account']['name']['#description'] .= ' ' . t('The pattern can be configured in the <a href="@settings">Account Settings</a>.', array(
        '@settings' => url('admin/config/people/settings'),
      ));
    }
  }

  if ($config->get('page_title_automatic')) {
    $account = isset($form['#user']) && is_object($form['#user']) ? $form['#user'] : NULL;
    $title = username_get_profile_title($account);

    if ($title !== FALSE) {
      backdrop_set_title($title);
      $form['#title'] = $title;
    }
  }
}

/**
 * Implements hook_user_presave().
 */
function username_user_presave($account) {
  // Generate the username.
  $account->name = username_generate($account);
}

/**
 * Generate a username for a user account.
 *
 * @param object $account
 *   The user object to generate the username for.
 *
 * @return string
 *   The generated username, or the existing username if a new one couldn't be
 *   generated.
 */
function username_generate($account) {
  $name = $account->name;
  $config = config('username.settings');

  if ($config->get('automatic')) {
    // Generate a username based on the pattern.
    $name = token_replace($config->get('pattern'), array('user' => $account), array(
      'clear' => TRUE,
      'callback' => 'username_clean_tokens',
    ));

    // Convert to lowercase if option enabled.
    if ($config->get('lower_case')) {
      $name = strtolower($name);
    }

    // If the generated username is different than the current username...
    if ($name != $account->name) {
      $i = 1;
      $unique = FALSE;
      $new_name = $name;

      // Make sure the username is unique.
      while (!$unique) {
        $existing = user_load_by_name($new_name);

        if ($existing && $existing->uid != $account->uid) {
          $new_name = $name . '_' . $i;
          $i++;
        }
        else {
          $unique = TRUE;
          $name = $new_name;
        }
      }
    }
  }

  return $name;
}

/**
 * Token callback: Clean tokens before using them.
 *
 * @see token_replace()
 */
function username_clean_tokens(&$replacements, $data, $options) {
  foreach ($replacements as $token => $value) {
    // Strip HTML tags.
    $value = strip_tags($value);

    // Transliterate.
    include_once BACKDROP_ROOT . '/core/includes/transliteration.inc';
    $value = transliteration_get($value, '');

    // Remove illegal characters.
    $value = preg_replace("/[^ a-z0-9@+_.'-]/i", '', $value);

    $replacements[$token] = $value;
  }
}

/**
 * Implements hook_preprocess_page().
 */
function username_preprocess_page(&$variables) {
  $title = username_get_profile_title();

  if ($title === FALSE) {
    return;
  }

  backdrop_set_title($title);
  $variables['title'] = $title;

  if (!empty($variables['head_title_array']) && is_array($variables['head_title_array'])) {
    $variables['head_title_array']['title'] = $title;

    $separator = $variables['head_title_array']['separator'] ?? ' | ';
    $head_parts = array();
    if (!empty($variables['head_title_array']['title'])) {
      $head_parts[] = $variables['head_title_array']['title'];
    }
    if (!empty($variables['head_title_array']['name'])) {
      $head_parts[] = $variables['head_title_array']['name'];
    }
    if (!empty($variables['head_title_array']['slogan'])) {
      $head_parts[] = $variables['head_title_array']['slogan'];
    }

    $variables['head_title'] = implode($separator, $head_parts);
  }
  else {
    $variables['head_title'] = $title;
  }
}

/**
 * Implements hook_preprocess_page_components().
 */
function username_preprocess_page_components(&$variables) {
  $title = username_get_profile_title();

  if ($title !== FALSE) {
    backdrop_set_title($title);
    $variables['title'] = $title;
  }
}

/**
 * Implements hook_preprocess_layout().
 */
function username_preprocess_layout(&$variables) {
  $title = username_get_profile_title();

  if ($title === FALSE) {
    return;
  }

  backdrop_set_title($title);

  $has_title_block = FALSE;
  if (!empty($variables['layout']) && isset($variables['layout']->content) && is_array($variables['layout']->content)) {
    foreach ($variables['layout']->content as $block) {
      if (isset($block->delta) && $block->delta === 'page_components') {
        $child_delta = $block->childDelta ?? NULL;
        if ($child_delta === 'title' || $child_delta === 'title_combo') {
          $has_title_block = TRUE;
          break;
        }
      }
    }
  }

  if (!$has_title_block) {
    $variables['title'] = $title;
  }

  if (!empty($variables['admin']) && isset($variables['content']) && is_array($variables['content']) && !$has_title_block) {
    $variables['content']['title'] = $title;
  }
}

/**
 * Implements hook_menu_breadcrumb_alter().
 */
function username_menu_breadcrumb_alter(&$active_trail, $item) {
  $account = username_get_profile_account();
  if (!$account) {
    return;
  }

  $title = username_get_profile_title($account);
  if ($title === FALSE) {
    return;
  }

  $safe_title = htmlspecialchars($title, ENT_QUOTES, 'UTF-8');
  $username_sanitized = htmlspecialchars($account->name, ENT_QUOTES, 'UTF-8');
  $target_paths = array(
    'user/' . $account->uid,
    'user/' . $account->uid . '/view',
  );

  foreach ($active_trail as &$link) {
    if (!is_array($link)) {
      continue;
    }

    $matches_username = isset($link['title']) && $link['title'] === $username_sanitized;
    $matches_path = isset($link['href']) && in_array($link['href'], $target_paths, TRUE);

    if (!$matches_username && !$matches_path) {
      continue;
    }

    $link['title'] = $safe_title;

    if (!isset($link['localized_options'])) {
      $link['localized_options'] = array();
    }

    if (!isset($link['localized_options']['attributes'])) {
      $link['localized_options']['attributes'] = array();
    }

    $link['localized_options']['attributes']['title'] = $title;
  }
}

/**
 * Implements hook_page_title_alter().
 */
function username_page_title_alter(&$title) {
  $new_title = username_get_profile_title();

  if ($new_title !== FALSE) {
    $title = $new_title;
  }
}

/**
 * Resolve the user account for the current user-related route.
 *
 * @return object|false
 *   The loaded user account when viewing a user profile path, or FALSE.
 */
function username_get_profile_account() {
  static $account;

  if (!isset($account)) {
    $account = FALSE;

    $candidate = menu_get_object('user', 1);
    if (is_object($candidate) && !empty($candidate->uid)) {
      $account = $candidate;
    }

    if ($account === FALSE) {
      $router_item = menu_get_item();
      if (!empty($router_item['map']) && is_array($router_item['map'])) {
        foreach ($router_item['map'] as $value) {
          if (is_object($value) && !empty($value->uid)) {
            $account = $value;
            break;
          }
        }
      }
    }

    if ($account === FALSE) {
      $path = current_path();
      $parts = explode('/', trim($path, '/'));

      if (!empty($parts[0]) && $parts[0] === 'user' && !empty($parts[1]) && is_numeric($parts[1])) {
        $account = user_load((int) $parts[1]);
      }
    }
  }

  return $account;
}

/**
 * Build the configured profile title for the current request.
 *
 * @return string|false
 *   The generated title string, or FALSE when generation is skipped.
 */
function username_get_profile_title($account = NULL) {
  static $cache = array();

  $config = config('username.settings');

  if (!$config->get('page_title_automatic')) {
    return FALSE;
  }

  if (!is_object($account)) {
    $account = username_get_profile_account();
  }

  if (!$account || empty($account->uid)) {
    return FALSE;
  }

  if (isset($cache[$account->uid])) {
    return $cache[$account->uid];
  }

  $pattern = trim($config->get('page_title_pattern'));
  if ($pattern === '') {
    $cache[$account->uid] = FALSE;
    return FALSE;
  }

  $generated = token_replace($pattern, array('user' => $account), array(
    'clear' => TRUE,
    'callback' => 'username_clean_tokens',
  ));

  if ($config->get('page_title_lower_case')) {
    $generated = strtolower($generated);
  }

  $generated = trim($generated);
  $cache[$account->uid] = ($generated === '') ? FALSE : $generated;

  return $cache[$account->uid];
}
